{
  "name": "aerocode",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"ts-node-dev --respawn --transpile-only src/server.ts\" \"npm run dev --prefix front\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts",
    "setup": "prisma migrate dev --name init --schema=prisma/schema.prisma && ts-node prisma/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "concurrently": "^10.0.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
